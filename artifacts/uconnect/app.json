{
  "expo": {
    "name": "UConnect",
    "slug": "uconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/fc29fe47-d29f-4636-910d-3a6c25fa777c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/logo-dark.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skmohammadali786.uconnect",
      "associatedDomains": [
        "applinks:uconnect.social",
        "applinks:uconnect.app"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "UConnect needs access to your photo library so you can upload profile and post images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.skmohammadali786.uconnect",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "uconnect.app",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "uconnect.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "uconnect.social",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "uconnect.social",
              "pathPrefix": "/events/"
            },
            {
              "scheme": "https",
              "host": "uconnect.social",
              "pathPrefix": "/event/"
            },
            {
              "scheme": "https",
              "host": "uconnect.social",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "uconnect.app",
              "pathPrefix": "/events/"
            },
            {
              "scheme": "https",
              "host": "uconnect.app",
              "pathPrefix": "/event/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fc29fe47-d29f-4636-910d-3a6c25fa777c"
      }
    }
  }
}
